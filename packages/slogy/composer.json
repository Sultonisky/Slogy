{
    "name": "sultonisky/slogy",
    "description": "Tamper-proof Laravel activity logging with cryptographic chain logging, blockchain-inspired integrity, and tamper-proof archives.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "log",
        "logging",
        "activity",
        "audit",
        "audit-trail",
        "security",
        "blockchain",
        "cryptographic",
        "tamper-proof"
    ],
    "homepage": "https://github.com/YOUR_USERNAME/slogy",
    "autoload": {
        "psr-4": {
            "Sultonisky\\Slogy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sultonisky\\Slogy\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "M. Sultoni",
            "email": "muhsultonipml111@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "phpunit/phpunit": "^12.5"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sultonisky\\Slogy\\SlogyServiceProvider"
            ]
        }
    }
}
