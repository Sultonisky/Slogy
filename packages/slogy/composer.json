    "description": "Simple Laravel activity logging package for tracking user actions.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sultonisky\\Slogy\\": "src/"
        }
    },
    "authors": [
        {
            "name": "M. Sultoni",
            "email": "muhsultonipml111@gmail.com"
        }
